# %% [FIGURES] Generate the three paper figures from the saved results
# Produces, in <BASE>/figures/:
#   real_gain_vs_dynamics.png   (needs dichasus/dichasus_cf0*_aligned.npz + _full.npz)
#   e1_pareto_nlms.png          (needs e1/e1_results_nlms.csv)
#   loc_error_cdf.png           (needs m3/paper3_M3_fr2_*_paired.h5)
# Each figure is independent: a missing input skips that figure with a message.
# Each figure also writes a .csv of the exact plotted values, for the repository.
#
# Style: IEEE single column (3.5 in), 400 dpi, colorblind-safe palette validated for
# CVD separation and print contrast; every series carries a distinct marker and dash
# pattern as well as a hue, so the figures survive grayscale printing.

import os, glob, json
import numpy as np
import matplotlib as mpl
import matplotlib.pyplot as plt

BASE = '/content/drive/MyDrive/paper3'
FIG_DIR = os.path.join(BASE, 'figures'); os.makedirs(FIG_DIR, exist_ok=True)

PAL     = ['#0072B2', '#D55E00', '#009E73', '#B07A00']
MARKERS = ['o', 's', '^', 'D']
DASHES  = ['-', '--', '-.', ':']

mpl.rcParams.update({
    'figure.figsize': (3.5, 2.6), 'figure.dpi': 140, 'savefig.dpi': 400,
    'font.size': 8, 'axes.labelsize': 8, 'axes.titlesize': 8,
    'legend.fontsize': 6.5, 'xtick.labelsize': 7, 'ytick.labelsize': 7,
    'axes.linewidth': 0.6, 'xtick.major.width': 0.6, 'ytick.major.width': 0.6,
    'grid.linewidth': 0.4, 'grid.alpha': 0.35, 'grid.linestyle': '-',
    'lines.linewidth': 1.4, 'lines.markersize': 4,
    'legend.frameon': False, 'axes.spines.top': False, 'axes.spines.right': False,
    'figure.constrained_layout.use': True,
})

def finish(fig, ax, path, legend_loc='best', below=False, ncol=1):
    ax.grid(True, which='major')
    if ax.get_legend_handles_labels()[0]:
        if below:   # safest for a 4-curve CDF: never collides with the data
            h, l = ax.get_legend_handles_labels()
            fig.legend(h, l, loc='outside lower center', ncol=ncol)
        else:
            ax.legend(loc=legend_loc)
    fig.savefig(path, bbox_inches='tight', pad_inches=0.02)
    print('  saved', os.path.basename(path))
    plt.show()

# ===========================================================================
# Shared predictor code (same implementations as the experiment notebooks)
# ===========================================================================
P_ORD, MU_NLMS, RLS_LAM, RLS_DEL, RCOND, TRAIN_FRAC = 4, 0.5, 0.995, 1e-2, 1e-4, 0.5

def run_pred(X, p, algo):
    """NMSE of a predictor on the evaluation half of X [T, K] (complex)."""
    T, K = X.shape
    t_split = int(TRAIN_FRAC*T)
    w = np.zeros((p, K), np.complex128)
    if algo == 'wiener':
        Xtr = X[:t_split]
        r = np.zeros((p+1, K), np.complex128); r[0] = (np.abs(Xtr)**2).mean(0)
        for k in range(1, p+1):
            r[k] = (Xtr[k:]*np.conj(Xtr[:-k])).mean(0)
        R = np.zeros((K, p, p), np.complex128)
        for i in range(p):
            for j in range(p):
                R[:, i, j] = np.conj(r[i-j]) if i >= j else r[j-i]
        w = (np.linalg.pinv(R, rcond=RCOND) @ np.conj(r[1:p+1]).T[..., None])[..., 0].T
    if algo == 'rls':
        Pm = np.tile((1.0/RLS_DEL)*np.eye(p, dtype=np.complex128), (K, 1, 1))
    e_all, d_all = [], []
    for t in range(p, T):
        u = X[t-p:t][::-1].astype(np.complex128)
        e = (X[t] - X[t-1]) if algo == 'naive' else (X[t] - (np.conj(w)*u).sum(0))
        e_all.append(e); d_all.append(X[t])
        if algo == 'nlms':
            w += MU_NLMS*u*np.conj(e)/((np.abs(u)**2).sum(0) + 1e-6)
        elif algo == 'rls':
            Pu = np.einsum('kij,jk->ik', Pm, u)
            g = Pu/(RLS_LAM + (np.conj(u)*Pu).sum(0))
            w += g*np.conj(e)
            uHP = np.einsum('ik,kij->jk', np.conj(u), Pm)
            Pm = (Pm - np.einsum('ik,jk->kij', g, uHP))/RLS_LAM
    e_all, d_all = np.array(e_all), np.array(d_all)
    m = np.zeros(len(e_all), bool); m[t_split-p:] = True
    return float((np.abs(e_all[m])**2).sum()/((np.abs(d_all[m])**2).sum() + 1e-30))

# ===========================================================================
# FIGURE 1 - gain over the trivial predictor vs segment dynamics (measured data)
# ===========================================================================
print('[1/3] real_gain_vs_dynamics.png')
DICH = os.path.join(BASE, 'dichasus')
N_ARRAY, N_ANT = 4, 32
ARR_IDX = [np.arange(a*8, (a+1)*8) for a in range(N_ARRAY)]   # spec.json: contiguous blocks

rows = []
for fid in ('cf02', 'cf03', 'cf04'):
    fp, fa = (os.path.join(DICH, f'dichasus_{fid}_{s}.npz') for s in ('full', 'aligned'))
    if not (os.path.exists(fp) and os.path.exists(fa)):
        continue
    Zf, ZA = np.load(fp), np.load(fa)
    EN = Zf['en'][np.argsort(Zf['time'])]
    csi_a, seg_id = ZA['csi'], ZA['seg_id']
    for si in np.unique(seg_id[seg_id >= 0]):
        s = np.where(seg_id == si)[0]
        if len(s) < 500:
            continue
        arr = np.bincount(EN[s].argmax(1), minlength=N_ARRAY).argmax()
        Xs = csi_a[s][:, ARR_IDX[arr]].reshape(len(s), -1)
        Xs = Xs/(np.sqrt((np.abs(Xs)**2).mean()) + 1e-30)
        rows.append((fid, int(si), len(s),
                     run_pred(Xs, P_ORD, 'naive'),
                     run_pred(Xs, P_ORD, 'wiener'),
                     run_pred(Xs, P_ORD, 'rls')))
    print(f'  {fid}: {sum(r[0] == fid for r in rows)} segments')

if not rows:
    print('  SKIPPED: no DICHASUS .npz files found in', DICH)
else:
    nv = np.array([r[3] for r in rows]); wi = np.array([r[4] for r in rows])
    rl = np.array([r[5] for r in rows])
    series = [('Fixed Wiener filter', nv/wi, 0), ('Adaptive filter (RLS)', nv/rl, 1)]

    fig, ax = plt.subplots()
    edges = np.logspace(np.log10(nv.min()*0.95), np.log10(nv.max()*1.05), 7)
    ctr = np.sqrt(edges[:-1]*edges[1:])
    for lab, g, k in series:
        ax.scatter(nv, g, s=13, marker=MARKERS[k], facecolors='none',
                   edgecolors=PAL[k], linewidths=0.8, alpha=0.75, zorder=2)
        med = np.array([np.median(g[(nv >= lo) & (nv < hi)]) if ((nv >= lo) & (nv < hi)).any()
                        else np.nan for lo, hi in zip(edges[:-1], edges[1:])])
        ok = ~np.isnan(med)
        ax.plot(ctr[ok], med[ok], DASHES[k], color=PAL[k], marker=MARKERS[k],
                markersize=4.5, markeredgecolor='white', markeredgewidth=0.5,
                label=lab, zorder=3)
    ax.axhline(1, color='0.45', lw=0.6, zorder=1)
    ax.text(nv.max()*0.92, 1.03, 'no gain', fontsize=6, color='0.35',
            ha='right', va='bottom')
    ax.set_xscale('log'); ax.set_yscale('log')
    ax.yaxis.set_major_formatter(mpl.ticker.FuncFormatter(
        lambda v, _: f'{v:g}' if v >= 1 else f'{v:.1f}'))
    ax.yaxis.set_minor_formatter(mpl.ticker.NullFormatter())
    ax.set_xlabel('Segment dynamics: trivial-predictor NMSE')
    ax.set_ylabel('Gain over trivial predictor')
    finish(fig, ax, os.path.join(FIG_DIR, 'real_gain_vs_dynamics.png'), 'lower center')

    with open(os.path.join(FIG_DIR, 'real_gain_vs_dynamics.csv'), 'w') as f:
        f.write('file,segment,samples,nmse_naive,nmse_wiener,nmse_rls\n')
        for r in rows:
            f.write(f'{r[0]},{r[1]},{r[2]},{r[3]:.6f},{r[4]:.6f},{r[5]:.6f}\n')

# ===========================================================================
# FIGURE 2 - error vs coefficient-update fraction (gating)
# ===========================================================================
print('[2/3] e1_pareto_nlms.png')
csv_path = os.path.join(BASE, 'e1', 'e1_results_nlms.csv')
if not os.path.exists(csv_path):
    print('  SKIPPED: not found', csv_path)
else:
    import pandas as pd
    df = pd.read_csv(csv_path)
    full = df[df.dataset.str.contains('M2full', na=False)]
    df = full if len(full) else df                     # prefer the full datasets
    LABELS = [('static_slow',  'Quasi-static terminal'),
              ('static_walk',  'Walking terminal'),
              ('Ns10',         '10 mobile scatterers'),
              ('Ns30',         '30 mobile scatterers')]
    fig, ax = plt.subplots()
    plotted, nev_y = [], []
    for k, (tag, nice) in enumerate(LABELS):
        g = df[df.dataset.str.contains(tag, na=False)]
        if g.empty:
            continue
        gated = g[g.policy.str.startswith('gated')].sort_values('update_frac')
        alw = g[g.policy == 'always']
        nev = g[g.policy.isin(['never_wiener', 'never'])]
        x = np.concatenate([gated.update_frac.values, alw.update_frac.values])*100
        y = np.concatenate([gated.nmse.values, alw.nmse.values])
        o = np.argsort(x)
        ax.plot(x[o], y[o], DASHES[k], color=PAL[k], marker=MARKERS[k],
                markeredgecolor='white', markeredgewidth=0.5, label=nice)
        if len(nev):
            nev_y.append(float(nev.nmse.values[0]))
            ax.plot([0.0], [nev.nmse.values[0]], marker=MARKERS[k], color=PAL[k],
                    markersize=5, markeredgecolor='white', markeredgewidth=0.6,
                    linestyle='none')
        for _, r in g.iterrows():
            plotted.append((nice, r.policy, r.update_frac, r.nmse))
    ax.set_xscale('symlog', linthresh=1); ax.set_yscale('log')
    ax.set_xlim(-0.1, 130); ax.set_xticks([0, 1, 10, 100])
    ax.set_xticklabels(['0', '1', '10', '100'])
    ax.set_xlabel('Coefficient updates performed [\\% of samples]'
                  .replace('\\%', '%'))
    ax.set_ylabel('Prediction NMSE')
    if nev_y:
        ax.annotate('no updates', xy=(0.06, max(nev_y)*1.9), fontsize=6,
                    color='0.35', ha='left')
    finish(fig, ax, os.path.join(FIG_DIR, 'e1_pareto_nlms.png'), 'lower left')

    with open(os.path.join(FIG_DIR, 'e1_pareto_nlms.csv'), 'w') as f:
        f.write('regime,policy,update_fraction,nmse\n')
        for r in plotted:
            f.write(f'{r[0]},{r[1]},{r[2]:.4f},{r[3]:.6f}\n')

# ===========================================================================
# FIGURE 3 - CDF of the intra-cluster localization error
# ===========================================================================
print('[3/3] loc_error_cdf.png')
h5s = sorted(glob.glob(os.path.join(BASE, 'm3', 'paper3_M3_fr2_*_paired.h5')))
if not h5s:
    print('  SKIPPED: no paired M3 .h5 found')
else:
    import h5py
    from sklearn.preprocessing import StandardScaler
    from sklearn.pipeline import make_pipeline
    from sklearn.neighbors import KNeighborsRegressor
    from sklearn.model_selection import train_test_split

    C, SEED, GAMMA_DB, LINK_BUDGET_DB, RES_THR = 3e8, 2026, -10.0, -124.0, 2.0
    TOA_Q = 1/400e6
    with h5py.File(h5s[-1], 'r') as f:
        UE = f['positions'][:]; TX = f['tx_positions'][:]
        E2 = f['fr2/E_dB_q'][:]; dt2 = f['fr2/dtau_q'][:]; ds2 = f['fr2/sigma_tau'][:]
        dphi = f['fr2/dphi'][:]
        E1 = f['fr1/E_dB_q'][:]; dt1 = f['fr1/dtau_q'][:]; ds1 = f['fr1/sigma_tau'][:]
    print(f'  {len(UE)} terminals from {os.path.basename(h5s[-1])}')

    heard = np.isfinite(dt2) & (E2 > LINK_BUDGET_DB)
    mem = (E2 >= np.where(heard, E2, -np.inf).max(1, keepdims=True) + GAMMA_DB) & heard
    dt2c = np.nan_to_num(dt2, nan=0.0, posinf=0.0, neginf=0.0)

    def multilaterate(dtau, members, tx, ue_z=1.5, iters=25):
        arrs = np.where(members)[0]
        ref = arrs[np.argmin(dtau[arrs])]
        oth = arrs[arrs != ref]
        meas = C*(dtau[oth] - dtau[ref])
        p = tx[arrs, :2].mean(0)
        for _ in range(iters):
            d = np.linalg.norm(tx - np.array([p[0], p[1], ue_z]), axis=1) + 1e-9
            r = (d[oth] - d[ref]) - meas
            J = (p - tx[oth, :2])/d[oth, None] - (p - tx[ref, :2])/d[ref]
            step = np.linalg.lstsq(J, r, rcond=None)[0]
            p = p - step
            if np.linalg.norm(step) < 1e-4:
                break
        return p

    d_geo = np.linalg.norm(UE[:, None, :] - TX[None, :, :], axis=2)
    solv = np.where(mem.sum(1) >= 3)[0]
    err_tdoa = np.full(len(UE), np.nan); res_tdoa = np.full(len(UE), np.nan)
    los = np.zeros(len(UE), bool)
    for i in solv:
        arrs = np.where(mem[i])[0]
        est = multilaterate(dt2c[i], mem[i], TX)
        err_tdoa[i] = np.linalg.norm(est - UE[i, :2])
        ref = arrs[np.argmin(dt2c[i, arrs])]
        oth = arrs[arrs != ref]
        dq = np.linalg.norm(TX - np.array([est[0], est[1], 1.5]), axis=1)
        res_tdoa[i] = np.sqrt(np.mean(((dq[oth]-dq[ref]) - C*(dt2c[i, oth]-dt2c[i, ref]))**2))
        # excess delay relative to the reference link: 0 for an all-LoS cluster
        exc = dt2c[i, arrs] - (d_geo[i, arrs] - d_geo[i, ref])/C
        los[i] = np.nanmax(np.abs(exc)) < 3*TOA_Q
    print(f'  solvable (>=3 cluster arrays): {len(solv)} ({len(solv)/len(UE)*100:.0f}%)'
          f' | all-LoS among them: {los[solv].mean()*100:.0f}%')

    feat = np.concatenate([E1, np.nan_to_num(dt1, posinf=0, nan=0)*1e6, ds1*1e9,
                           E2, np.nan_to_num(dt2, posinf=0, nan=0)*1e6, ds2*1e9,
                           dphi], 1)
    idx = np.arange(len(UE))
    itr, ite = train_test_split(idx, test_size=0.2, random_state=SEED)
    knn = make_pipeline(StandardScaler(), KNeighborsRegressor(5)).fit(feat[itr], UE[itr, :2])
    err_knn = np.linalg.norm(knn.predict(feat[ite]) - UE[ite, :2], axis=1)

    use_geo = np.isfinite(res_tdoa[ite]) & (res_tdoa[ite] < RES_THR)
    err_hyb = np.where(use_geo, np.nan_to_num(err_tdoa[ite], nan=1e9), err_knn)
    te_solv = ite[np.isfinite(err_tdoa[ite])]
    te_los = ite[np.isfinite(err_tdoa[ite]) & los[ite]]

    curves = [
        (f'Fingerprinting (kNN)', err_knn, 0),
        (f'TDoA, $\\geq$3 arrays ({len(te_solv)/len(ite)*100:.0f}\\% of terminals)',
         err_tdoa[te_solv], 1),
        (f'TDoA, all-LoS clusters ({len(te_los)/len(ite)*100:.0f}\\% of terminals)',
         err_tdoa[te_los], 2),
        ('Residual-gated hybrid', err_hyb, 3),
    ]
    fig, ax = plt.subplots(figsize=(3.5, 3.1))
    for lab, e, k in curves:
        e = np.sort(np.asarray(e)[np.isfinite(e)])
        if not len(e):
            continue
        y = np.arange(1, len(e)+1)/len(e)
        ax.plot(e, y, DASHES[k], color=PAL[k], label=lab.replace('\\%', '%'),
                markevery=max(len(e)//6, 1), marker=MARKERS[k],
                markeredgecolor='white', markeredgewidth=0.5)
    ax.axvline(1.0, color='0.45', lw=0.6, zorder=1)
    ax.text(1.12, 0.06, '1 m', fontsize=6, color='0.35')
    ax.set_xscale('log'); ax.set_xlim(0.02, 300); ax.set_ylim(0, 1.02)
    ax.set_xlabel('Localization error [m]')
    ax.set_ylabel('Empirical CDF')
    finish(fig, ax, os.path.join(FIG_DIR, 'loc_error_cdf.png'), below=True, ncol=2)

    with open(os.path.join(FIG_DIR, 'loc_error_cdf.csv'), 'w') as f:
        f.write('method,error_m\n')
        for lab, e, _ in curves:
            for v in np.asarray(e)[np.isfinite(e)]:
                f.write(f'"{lab}",{v:.4f}\n')
    print(f"  medians: kNN {np.median(err_knn):.2f} | TDoA {np.nanmedian(err_tdoa[te_solv]):.2f}"
          f" | LoS {np.nanmedian(err_tdoa[te_los]):.2f} | hybrid {np.median(err_hyb):.2f} m")

print('\nAll done. Copy', FIG_DIR, 'next to the .tex and uncomment the \\includegraphics lines.')
